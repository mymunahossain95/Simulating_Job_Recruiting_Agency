<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Prottoy.SystemSettingsController">
   <children>
      <ComboBox fx:id="settingTypeCombo" layoutX="15.0" layoutY="133.0" prefWidth="150.0" />
      <TextField fx:id="settingValueField" layoutX="300.0" layoutY="133.0" />
      <Button layoutX="280.0" layoutY="272.0" mnemonicParsing="false" onAction="#onSaveSettings" text="Save" />
      <Text layoutX="15.0" layoutY="119.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Setting Type" />
      <Text layoutX="300.0" layoutY="119.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Value" />
      <Button layoutX="521.0" layoutY="361.0" mnemonicParsing="false" onAction="#onBack" text="Back" />
      <Text layoutX="233.0" layoutY="38.0" strokeType="OUTSIDE" strokeWidth="0.0" text="  SYSTEM SETTINGS" />
   </children>
</AnchorPane>
