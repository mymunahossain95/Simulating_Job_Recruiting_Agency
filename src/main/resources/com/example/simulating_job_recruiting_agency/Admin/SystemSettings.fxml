<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="322.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="prottoy.SystemSettingsController">
   <children>
      <ComboBox layoutX="24.0" layoutY="108.0" onAction="#settingTypeCombo" prefWidth="150.0" />
      <TextField fx:id="settingValueField" layoutX="300.0" layoutY="108.0" />
      <Button layoutX="256.0" layoutY="200.0" mnemonicParsing="false" onAction="#onSaveSettings" text="Save" />
      <Text layoutX="24.0" layoutY="94.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Setting Type" />
      <Text layoutX="300.0" layoutY="94.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Value" />
      <Button layoutX="526.0" layoutY="279.0" mnemonicParsing="false" onAction="#onBack" prefHeight="26.0" prefWidth="41.0" text="Back" />
      <Text layoutX="224.0" layoutY="27.0" strokeType="OUTSIDE" strokeWidth="0.0" text=" SYSTEM SETTINGS " />
   </children>
</AnchorPane>
