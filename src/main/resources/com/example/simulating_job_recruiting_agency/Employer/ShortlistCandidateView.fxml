          <TableColumn fx:id="candidateIdTC" prefWidth="106.0" text="Candidate ID" />
          <TableColumn fx:id="candidateNameTC" prefWidth="139.0" text="Candidate Name" />
            <TableColumn fx:id="appliedPositionTC" prefWidth="147.0" text="Applied Position" />
