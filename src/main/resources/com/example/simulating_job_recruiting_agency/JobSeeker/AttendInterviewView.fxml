<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Mymuna.AttendInterviewViewController">
   <children>
      <Label layoutX="215.0" layoutY="39.0" prefHeight="17.0" prefWidth="179.0" text="Scheduled Interviews" />
      <TableView fx:id="attendinterviewViewTV" layoutX="52.0" layoutY="70.0" prefHeight="185.0" prefWidth="497.0">
        <columns>
          <TableColumn fx:id="interviewIdTC" prefWidth="75.0" text="interviewId" />
          <TableColumn fx:id="companyNameTC" prefWidth="111.0" text="companyName" />
            <TableColumn fx:id="interviewDateTC" prefWidth="104.0" text="interviewDate" />
            <TableColumn fx:id="interviewTimeTC" prefWidth="95.0" text="interviewTime" />
            <TableColumn fx:id="attendanceStatusTC" prefWidth="111.0" text="attendanceStatus" />
        </columns>
      </TableView>
      <Button layoutX="228.0" layoutY="270.0" mnemonicParsing="false" onAction="#confirmAttendanceOA" text="confirmAttendanceButton" />
      <Label fx:id="statusLabel" layoutX="52.0" layoutY="345.0" text="Status" />
      <Label fx:id="statusForScheduledInterviewLabel" layoutX="111.0" layoutY="345.0" text="Label" />
      <Button layoutX="470.0" layoutY="320.0" mnemonicParsing="false" onAction="#backToDashboardOA" text="Back To Dashboard" />
   </children>
</AnchorPane>
