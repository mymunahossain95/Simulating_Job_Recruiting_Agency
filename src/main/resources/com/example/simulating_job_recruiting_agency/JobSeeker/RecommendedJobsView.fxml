<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mymuna.RecommendedJobsViewController">
   <children>
      <Label layoutX="70.0" layoutY="50.0" text="Recommended Jobs" />
      <Label layoutX="70.0" layoutY="95.0" text="Recommended Job List" />
      <Button layoutX="395.0" layoutY="55.0" mnemonicParsing="false" onAction="#viewJobDetailsOA" text="View Job Details" />
      <Button layoutX="403.0" layoutY="91.0" mnemonicParsing="false" onAction="#applyNowOA" text="Apply Now" />
      <TableView fx:id="recommendedJobsTV" layoutX="77.0" layoutY="171.0" prefHeight="200.0" prefWidth="505.0">
        <columns>
          <TableColumn fx:id="jobIdTC" prefWidth="75.0" text="Job ID" />
          <TableColumn fx:id="jobTitleTC" prefWidth="75.0" text="Job Title" />
            <TableColumn fx:id="companyNameTC" prefWidth="113.0" text="Company Name" />
            <TableColumn fx:id="matchPercentageTC" prefWidth="118.0" text="Match Percentage" />
            <TableColumn fx:id="applixationDeadlineTC" prefWidth="123.0" text="Application Deadline" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
