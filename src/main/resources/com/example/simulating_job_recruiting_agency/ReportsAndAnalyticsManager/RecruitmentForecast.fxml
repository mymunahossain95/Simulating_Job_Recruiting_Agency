<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="484.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Utsita.RecruitmentForecastController">
   <children>
      <ComboBox fx:id="forecastPeriodComboBox" layoutX="142.0" layoutY="86.0" prefWidth="150.0" />
      <Text layoutX="49.0" layoutY="103.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Forecast Period" />
      <Button layoutX="49.0" layoutY="178.0" mnemonicParsing="false" onAction="#onGenerateForecast" text="Generate Forecast" />
      <Button layoutX="90.0" layoutY="433.0" mnemonicParsing="false" onAction="#onExportForecast" text="Export Forecast" />
      <Button layoutX="537.0" layoutY="14.0" mnemonicParsing="false" onAction="#homeButton" text="Home" />
      <TableView fx:id="foreCastTableView" layoutX="90.0" layoutY="213.0" prefHeight="200.0" prefWidth="421.0">
        <columns>
          <TableColumn fx:id="yeArTableColumn" prefWidth="75.0" text="Year" />
            <TableColumn fx:id="expectedVacanciesTableColumn" prefWidth="128.0" text="Expected Vacancies" />
            <TableColumn fx:id="growthRateTableColumn" prefWidth="99.0" text="Growth Rate" />
            <TableColumn fx:id="recomMendationTableColumn" prefWidth="119.0" text="Recommendation" />
        </columns>
      </TableView>
      <Label layoutX="245.0" layoutY="18.0" text="Recruitment Forecast">
         <font>
            <Font size="15.0" />
         </font>
         <effect>
            <DropShadow />
         </effect>
      </Label>
   </children>
</AnchorPane>
