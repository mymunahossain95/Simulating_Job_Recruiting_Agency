<AnchorPane prefHeight="480.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Utsita.RecruitmentPerformanceController">
   <children>
      <TableView fx:id="recruitmentPerformanceTableView" layoutX="76.0" layoutY="225.0" prefHeight="200.0" prefWidth="448.0">
        <columns>
          <TableColumn fx:id="departMentTableColumn" prefWidth="86.0" text="Department" />
          <TableColumn fx:id="recruitMentsTableColumn" prefWidth="92.0" text="Recruitments" />
            <TableColumn fx:id="avgHiringTimeTableColumn" prefWidth="158.0" text="Average Hiring Time" />
            <TableColumn fx:id="successRateTableColumn" prefWidth="111.0" text="Success Rate" />
        </columns>
      </TableView>
      <Button layoutX="24.0" layoutY="191.0" mnemonicParsing="false" onAction="#onGenerateReport" text="Generate Report" />
      <Button layoutX="14.0" layoutY="441.0" mnemonicParsing="false" onAction="#exportButton" text="Export " />
      <ComboBox fx:id="reportTypeComboBox" layoutX="101.0" layoutY="78.0" prefWidth="150.0" />
      <Text layoutX="24.0" layoutY="95.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Report Type:" />
      <DatePicker fx:id="reportDateDatePicker" layoutX="101.0" layoutY="114.0" prefHeight="17.0" prefWidth="129.0" />
      <Text layoutX="25.0" layoutY="131.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Report Date:" />
      <Button layoutX="537.0" layoutY="14.0" mnemonicParsing="false" onAction="#homeButton" text="Home" />
      <Label layoutX="213.0" layoutY="18.0" text="Recruitment Performance Report">
         <font>
            <Font size="15.0" />
         </font>
         <effect>
            <DropShadow />
         </effect>
      </Label>
   </children>
</AnchorPane>
