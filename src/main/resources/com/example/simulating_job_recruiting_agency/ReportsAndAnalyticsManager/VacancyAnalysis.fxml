<AnchorPane prefHeight="470.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Utsita.VacancyAnalysisController">
   <children>
      <DatePicker fx:id="analysisDatePicker" layoutX="120.0" layoutY="72.0" prefHeight="17.0" prefWidth="115.0" />
      <Text layoutX="32.0" layoutY="89.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Analysis Date:" />
      <Button layoutX="54.0" layoutY="172.0" mnemonicParsing="false" onAction="#onGenerateReport" text="Generate Report" />
      <Button layoutX="537.0" layoutY="12.0" mnemonicParsing="false" onAction="#homeButton" text="Home" />
      <TableView fx:id="vacancyAnalysisTableView" layoutX="120.0" layoutY="210.0" prefHeight="200.0" prefWidth="361.0">
        <columns>
          <TableColumn fx:id="jobTitleTableColumn" prefWidth="73.0" text="Job Title" />
            <TableColumn fx:id="compAnyTableColumn" prefWidth="81.0" text="Company" />
            <TableColumn fx:id="daysRequiredTableColumn" prefWidth="132.0" text="Days Required" />
            <TableColumn fx:id="statusTableColumn" prefWidth="73.0" text="Status" />
        </columns>
      </TableView>
      <Label layoutX="245.0" layoutY="14.0" text="Vacancy Analysis">
         <font>
            <Font size="15.0" />
         </font>
         <effect>
            <DropShadow />
