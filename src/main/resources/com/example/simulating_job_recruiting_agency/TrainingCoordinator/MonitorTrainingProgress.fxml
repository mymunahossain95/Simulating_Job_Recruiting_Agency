<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="511.0" prefWidth="570.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Utsita.MonitorTrainingProgressController">
   <children>
      <ComboBox fx:id="trainingProgramComboBox" layoutX="137.0" layoutY="82.0" prefHeight="16.0" prefWidth="120.0" />
      <ComboBox fx:id="sessionComboBox" layoutX="137.0" layoutY="119.0" prefHeight="16.0" prefWidth="120.0" />
      <Button layoutX="385.0" layoutY="158.0" mnemonicParsing="false" onAction="#loadProgressButton" text="Load Progress" />
      <Text layoutX="39.0" layoutY="99.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Training Program" />
      <Text layoutX="39.0" layoutY="136.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Session" />
      <Label fx:id="completationRateLabel" layoutX="125.0" layoutY="442.0" text="Completion Rate:">
         <font>
            <Font size="14.0" />
         </font>
         <effect>
            <DropShadow />
         </effect></Label>
      <Button layoutX="125.0" layoutY="397.0" mnemonicParsing="false" onAction="#updateProgressButton" text="Update Progress" />
      <TableView fx:id="trainingProgressTableView" layoutX="125.0" layoutY="191.0" prefHeight="200.0" prefWidth="351.0">
        <columns>
          <TableColumn fx:id="candidateTableColumn" prefWidth="87.0" text="Candidate" />
          <TableColumn fx:id="attendanceTableColumn" prefWidth="92.0" text="Attendance" />
            <TableColumn fx:id="progressTableColumn" prefWidth="87.0" text="Progress" />
            <TableColumn fx:id="statusTableColumn" prefWidth="84.0" text="Status" />
        </columns>
      </TableView>
      <Button layoutX="509.0" layoutY="14.0" mnemonicParsing="false" onAction="#homeButton" text="Home" />
      <Label layoutX="214.0" layoutY="16.0" text="Monitor Training Progress">
         <font>
            <Font size="15.0" />
         </font>
         <effect>
            <DropShadow />
         </effect>
      </Label>
   </children>
</AnchorPane>
